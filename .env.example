# Copy this file to .env and fill in your Supabase connection string.
# Never commit .env to git.

# Supabase → Project Settings → Database → Connection string → URI
# Use the "Session mode" pooler (port 5432) for a persistent background worker.
# Transaction mode (port 6543) is for serverless — do NOT use it here.
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres

# Optional
LOG_LEVEL=INFO
